{
  "name": "hireai-platform",
  "version": "1.0.0",
  "description": "HireAI — Autonomous AI Video Interviewer with Dual-Camera Intelligent Proctoring Suite",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-ws": "^5.0.2",
    "html2pdf.js": "^0.14.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.2.1",
    "pdf-parse": "^1.1.1",
    "qrcode.react": "^4.2.0",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  }
}
